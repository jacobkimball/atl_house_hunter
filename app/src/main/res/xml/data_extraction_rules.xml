<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same short list for cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="markers.json" />
        <include domain="file" path="strokes.json" />
        <include domain="file" path="layers.json" />
        <include domain="sharedpref" path="househunter.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="markers.json" />
        <include domain="file" path="strokes.json" />
        <include domain="file" path="layers.json" />
        <include domain="sharedpref" path="househunter.xml" />
    </device-transfer>
</data-extraction-rules>
